# ==============================================
# Finora - Environment Configuration Template
# ==============================================

# Backend Database Connection
# SQLite default for local development
DATABASE_URL=sqlite:///./finora.db

# API & Server Settings
PROJECT_NAME=Finora
ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Optional OCR / Document Extraction Keys (Placeholder / Not required for base local operations)
DOCUMENT_EXTRACTION_PROVIDER=local
